# NEXA DELIVERY · production environment template
# Copy values into the deployment platform / secret manager.
# Never commit real passwords or service tokens.

NODE_ENV=production

# ---------- Service Operations API ----------
PORT=8792
NEXA_OPS_DB_PATH=/srv/nexa/data/nexa-ops.sqlite
# Leave equal to NEXA_OPS_DB_PATH to keep auth + ops in one SQLite file.
NEXA_OPS_AUTH_DB_PATH=/srv/nexa/data/nexa-ops.sqlite
NEXA_INQUIRY_DB_PATH=/srv/nexa/data/inquiries.sqlite
NEXA_OPS_ALLOWED_ORIGINS=https://ops.example.invalid
NEXA_OPS_SESSION_MAX_MS=28800000
NEXA_OPS_SESSION_IDLE_MS=1800000
NEXA_OPS_AGENTS_JSON=[{"id":1,"name":"Field Agent 1","region":"Seoul","active":true}]
# First startup only. Inject through a secret store, then remove from runtime configuration.
NEXA_OPS_BOOTSTRAP_ADMIN_JSON=
# Machine-to-machine principal used by the Inquiry API. Inject through a secret store.
NEXA_OPS_PRINCIPALS_JSON=

# ---------- Customer Inquiry API ----------
# Run this process with PORT=8796 in its own service environment.
NEXA_INQUIRY_DB_PATH=/srv/nexa/data/inquiries.sqlite
NEXA_INQUIRY_ALLOWED_ORIGINS=https://service.example.invalid
NEXA_INQUIRY_TRUST_PROXY=1
NEXA_INQUIRY_RATE_WINDOW_MS=600000
NEXA_INQUIRY_RATE_MAX=5
# Secure customer access is the production default. Keep legacy phone-based customer lookup disabled.
NEXA_ALLOW_LEGACY_CUSTOMER_ACCESS=0
# Legacy/admin API principal. Inject through a secret store.
NEXA_INQUIRY_ADMINS_JSON=
NEXA_FIELD_OPS_URL=https://ops-api.example.invalid
# Must match a machine-to-machine principal configured in NEXA_OPS_PRINCIPALS_JSON.
NEXA_FIELD_OPS_SERVICE_TOKEN=


# ---------- Secure Customer Access API ----------
# Run this process with PORT=8797. It shares the Inquiry DB but keeps OTP/session state separate.
NEXA_CUSTOMER_ACCESS_DB_PATH=/srv/nexa/data/customer-access.sqlite
NEXA_CUSTOMER_ALLOWED_ORIGINS=https://service.example.invalid
NEXA_CUSTOMER_TRUST_PROXY=1
NEXA_CUSTOMER_OTP_TTL_MS=300000
NEXA_CUSTOMER_OTP_MAX_ATTEMPTS=5
NEXA_CUSTOMER_SESSION_MAX_MS=3600000
NEXA_CUSTOMER_SESSION_IDLE_MS=1200000
# Required in production. Provider adapter receives {channel,to,code,requestId}.
NEXA_CUSTOMER_OTP_WEBHOOK_URL=https://otp-provider.example.invalid/send
NEXA_CUSTOMER_OTP_WEBHOOK_TOKEN=

# ---------- Public web delivery build ----------
NEXA_PUBLIC_API_ORIGIN=https://service.example.invalid
NEXA_OPS_API_ORIGIN=https://ops.example.invalid
NEXA_CUSTOMER_SECURE_ORIGIN=https://service.example.invalid
NEXA_DELIVERY_DIR=/srv/nexa/web

# ---------- Backup ----------
NEXA_BACKUP_DIR=/srv/nexa/backups
