NODE_ENV=production
MONO_BIND=127.0.0.1
MONO_PORT=8796
MONO_PUBLIC_ORIGIN=https://ops.example.com
MONO_DB_PATH=/var/lib/mono-operations/mono.sqlite
MONO_SECRET_KEY=BASE64_32_BYTE_KEY
MONO_SESSION_TTL_SECONDS=28800
MONO_TRUST_PROXY=1
MONO_INTEGRATION_POLL_MS=2000
MONO_INTEGRATION_ALLOW_HOSTS=erp.example.com,warehouse.example.com
MONO_AI_PROVIDERS=[{"id":"primary","baseUrl":"https://api.openai.com/v1","apiKey":"SERVER_SIDE_SECRET","model":"MODEL_NAME","timeoutMs":15000}]

# First start only. Remove the password after the first admin is created.
MONO_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
MONO_BOOTSTRAP_ADMIN_NAME=Operations Admin
MONO_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_12_PLUS
